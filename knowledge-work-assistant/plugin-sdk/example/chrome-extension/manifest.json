{
  "manifest_version": 3,
  "name": "KWA Push Demo",
  "version": "1.0.0",
  "description": "知识工作助手插件推送 SDK 最小示例",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8788/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "KWA Push Demo"
  }
}
