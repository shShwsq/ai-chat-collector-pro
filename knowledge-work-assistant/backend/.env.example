# ===== 运行环境 =====
APP_ENV=development

# ===== LLM 配置（OpenAI 兼容协议）=====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# ===== 数据与存储 =====
# 数据目录：后端运行期写入（SQLite、上传文件、会话数据、加密 key 等）
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ===== 加密 key（敏感字段加密存储，留空则自动生成并保存到 data/.encryption_key）=====
APP_ENCRYPTION_KEY=

# ===== CORS 允许的前端来源（开发环境 Vite dev server 5174）=====
# 多个来源用 JSON 数组表示，例如：["http://localhost:5174","file://"]
CORS_ORIGINS=["http://localhost:5174","file://"]

# ===== 后端监听端口（仅用于 python -m app.main 直接启动时；uvicorn 命令用 --port 8788）=====
BACKEND_PORT=8788

# ===== 本地 API 鉴权 token（前后端共享，统一来源）=====
# 后端 enforce_request_limits_and_cache_policy 中间件要求所有 /api/ 请求
# 携带 x-local-api-token 头，值等于此处的 LOCAL_API_TOKEN。
# 前端两处亦读取本值：
#   - 纯浏览器 dev（pnpm dev）：Vite 启动时经 loadEnv 读取并 define 注入渲染进程；
#   - Electron（dev:electron / 生产）：launcher 解析本文件后经 preload 桥下发。
# 修改后需同步重启前后端。生产环境建议改为高强度随机值（且不要把 .env 随包发布）。
LOCAL_API_TOKEN=kwa-development-token
