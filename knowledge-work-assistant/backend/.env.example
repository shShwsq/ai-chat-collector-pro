# ===== 运行环境 =====
APP_ENV=development

# ===== LLM 配置（OpenAI 兼容协议）=====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# ===== 数据与存储 =====
# 数据目录：后端运行期写入（SQLite、上传文件、会话数据、加密 key 等）
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ===== 加密 key（敏感字段加密存储，留空则自动生成并保存到 data/.encryption_key）=====
APP_ENCRYPTION_KEY=

# ===== CORS 允许的前端来源（开发环境 Vite dev server 5174）=====
# 多个来源用 JSON 数组表示，例如：["http://localhost:5174","file://"]
CORS_ORIGINS=["http://localhost:5174","file://"]

# ===== 后端监听端口（仅用于 python -m app.main 直接启动时；uvicorn 命令用 --port 8788）=====
BACKEND_PORT=8788
